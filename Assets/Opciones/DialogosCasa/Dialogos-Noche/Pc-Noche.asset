  m_Name: Pc-Noche
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: .
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: Pantalla en negro. Veo mi propio reflejo en el cristal.
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Qu\xE9 asco de cara. Qu\xE9 asco de postura. Qu\xE9 asco de existencia."
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Buscaba mierdas raras en la ma\xF1ana para distraerme de lo pat\xE9tica
      que es mi vida..."
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Ahora ni la pantalla encendida me quita la sensaci\xF3n de que soy un
      desperdicio de espacio."
  opciones: []
