  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "La estaci\xF3n de limpieza de la casa\u2026 "
    voiceClip: {fileID: 8300000, guid: 80b612db399d7a5499e607793c9ba1f1, type: 3}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Sin esto toda mi ropa podria oler tan mal que hasta yo la quemar\xEDa "
    voiceClip: {fileID: 8300000, guid: 6f9ee7d34fc4ce54080a5151b854523f, type: 3}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Tengo que admitirlo\u2026  "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Al hijo de puta que se le ocurri\xF3 esto merece un altar "
    voiceClip: {fileID: 8300000, guid: 2d233cfa08777f443b32d01a5b788ec3, type: 3}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Aunque\u2026 ya est\xE1 muerto\u2026 "
    voiceClip: {fileID: 8300000, guid: f173a0d2e49e99248ab26bbed838ed41, type: 3}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Meh, de seguro obtuvo el reconocimiento que necesitaba mientras a\xFAn
      estaba vivo "
    voiceClip: {fileID: 8300000, guid: 67f195e75308233428475afa797544d4, type: 3}
