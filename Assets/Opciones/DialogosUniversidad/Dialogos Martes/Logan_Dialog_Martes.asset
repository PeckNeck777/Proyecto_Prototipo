  m_Script: {fileID: 11500000, guid: 99b96955713899042b7125f4d9066314, type: 3}
  m_Name: Logan_Dialog_Martes
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Maestro Logan Niza
    portrait: {fileID: 21300000, guid: 31c7bdf4c59771145b41354d826d2009, type: 3}
    line: "\xA1Se\xF1orita Mizuki! \xA1Ya es un minuto tarde! \xBFSe puede saber
      por qu\xE9 la impuntualidad? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Lamento el retraso\u2026 pero tuve algunos problemas y-"
    voiceClip: {fileID: 0}
  - spaeker: Maestro Logan Niza
    portrait: {fileID: 21300000, guid: 31c7bdf4c59771145b41354d826d2009, type: 3}
    line: "\xA1Nada de excusas! \xBFNo le he dicho que el ser impuntual no la lleva
      a nada bueno? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xA1Por eso Lazz est\xE1 igual de jodido que hace 5 a\xF1os! "
    voiceClip: {fileID: 0}
  - spaeker: Maestro Logan Niza
    portrait: {fileID: 21300000, guid: 31c7bdf4c59771145b41354d826d2009, type: 3}
    line: "\xA1Exacto! Solo quiero que- "
    voiceClip: {fileID: 0}
  - spaeker: Maestro Logan Niza
    portrait: {fileID: 21300000, guid: 31c7bdf4c59771145b41354d826d2009, type: 3}
    line: ...!
    voiceClip: {fileID: 0}
  - spaeker: Maestro Logan Niza
    portrait: {fileID: 21300000, guid: 31c7bdf4c59771145b41354d826d2009, type: 3}
    line: "Mejor sigamos con la clase\u2026 "
    voiceClip: {fileID: 0}
  opciones:
