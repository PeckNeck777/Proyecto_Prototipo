  m_Script: {fileID: 11500000, guid: 99b96955713899042b7125f4d9066314, type: 3}
  m_Name: Prima_DateDialog_Martes 2
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "Eso espero por tu bien, amiguita de la infancia. Nos conocemos desde ni\xF1as,
      Mizuki\u2026 s\xE9 perfectamente de qu\xE9 pie cojeas y lo fr\xE1gil que est\xE1s.
      Si mi hermana sale llorando por tu culpa, no habr\xE1 pasado de infancia que
      te salve."
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Su tono duele m\xE1s porque s\xE9 que fuimos mejores amigas\u2026 antes
      de que ella decidiera convertirse en este monstruo protector.)"
    voiceClip: {fileID: 0}
  opciones: []
