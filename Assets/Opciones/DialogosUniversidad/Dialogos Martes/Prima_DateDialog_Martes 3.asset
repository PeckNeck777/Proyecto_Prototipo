  conversation:
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "No te estoy amenazando, preciosa\u2026 te estoy informando. M\xE1s te
      vale cumplir. Ahora pi\xE9rdete de mi vista, me arruinas la iluminaci\xF3n
      del pasillo."
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Agacho la cabeza y sigo de largo. Ojal\xE1 pudiera desaparecer ahora
      mismo.)"
    voiceClip: {fileID: 0}
