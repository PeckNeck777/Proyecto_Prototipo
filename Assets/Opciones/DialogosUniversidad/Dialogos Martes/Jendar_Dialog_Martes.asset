  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "\xA1Carajo! El calor de este traje\u2026 me est\xE1 matando\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Solo qu\xEDtatelo, no puede ser tan malo\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "\xBFY dejar que se pierda el misterio? No, gracias "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Jendar\u2026 el \xFAnico misterio del dia es saber a qu\xE9 ba\xF1o vas
      a entrar "
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "\xA1Y eso le da el toque de magia!"
    voiceClip: {fileID: 0}
  opciones: []
