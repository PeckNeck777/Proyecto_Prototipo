  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Flor Eria
    portrait: {fileID: 21300000, guid: 1e66bde773ff52c4698430dd2d9f738e, type: 3}
    line: " \xBFMizuki? Es raro verte por aqu\xED\u2026 usualmente a esta hora estudias "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Buenas tardes\u2026 solo quer\xEDa despejar la mente del estudio luego
      de un d\xEDa tan largo "
    voiceClip: {fileID: 0}
  - spaeker: Flor Eria
    portrait: {fileID: 21300000, guid: 1e66bde773ff52c4698430dd2d9f738e, type: 3}
    line: "Entiendo\u2026 es natural buscar un descanso \xBFNo?"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFAunque eso me haga sentir culpable? "
    voiceClip: {fileID: 0}
  - spaeker: Flor Eria
    portrait: {fileID: 21300000, guid: 1e66bde773ff52c4698430dd2d9f738e, type: 3}
    line: "Te dire algo\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Flor Eria
    portrait: {fileID: 21300000, guid: 1e66bde773ff52c4698430dd2d9f738e, type: 3}
    line: "\xBFPorque no me buscas 7 flores?"
    voiceClip: {fileID: 0}
  - spaeker: Flor Eria
    portrait: {fileID: 21300000, guid: 1e66bde773ff52c4698430dd2d9f738e, type: 3}
    line: "Las necesito para terminar el jard\xEDn\u2026 quiz\xE1s eso no te haga
      sentir de ese modo\u2026 "
    voiceClip: {fileID: 0}
  opciones: []
