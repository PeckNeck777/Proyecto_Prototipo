    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBF\xA1Como sabe de ella!?"
    voiceClip: {fileID: 0}
  - spaeker: Flor Eria
    portrait: {fileID: 21300000, guid: 1e66bde773ff52c4698430dd2d9f738e, type: 3}
    line: Cielo, las paredes son todo menos a prueba de sonido...
    voiceClip: {fileID: 0}
  - spaeker: Flor Eria
    portrait: {fileID: 21300000, guid: 1e66bde773ff52c4698430dd2d9f738e, type: 3}
    line: Quizas puedas hablar un poco mas bajo
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
