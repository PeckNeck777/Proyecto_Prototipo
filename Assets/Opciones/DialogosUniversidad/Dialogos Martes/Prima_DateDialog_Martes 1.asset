  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "Vaya, vaya\u2026 Te ves muy relajada para alguien que ayer recibi\xF3
      una advertencia muy clara. \xBFO es que cre\xEDste que estaba bromeando?"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Yo\u2026 no he hecho nada malo, solo\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "Ayer dijiste que ibas a invitar a salir a mi hermana. Y m\xE1s te vale
      que sea una cita decente, porque si la lastimas o la metes en problemas por
      tu culpa\u2026 ya sabes lo que te espera."
    voiceClip: {fileID: 0}
