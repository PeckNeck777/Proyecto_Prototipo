  m_Script: {fileID: 11500000, guid: 99b96955713899042b7125f4d9066314, type: 3}
  m_Name: Prima_NormalDialog_Martes 1
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "Vaya\u2026 no hay tantas miradas sobre m\xED en este pasillo como pens\xE9
      que habr\xEDa\u2026 \xA1Tanto arreglarme para la clase de hoy para nada!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Como siempre\u2026 necesitando ser el centro de atenci\xF3n de todo el
      campus."
    voiceClip: {fileID: 0}
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "Yo disfruto del cari\xF1o de la gente\u2026 y de los beneficios de que
      me miren, querida. \xBFAcaso est\xE1 prohibido?"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFCobras por que te miren en tus redes o qu\xE9? Es como\u2026 prostituci\xF3n
      en l\xEDnea\u2026 solo que con m\xE1s ego."
    voiceClip: {fileID: 0}
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "Querida, no confundas a una empresaria del espect\xE1culo con una cualquiera\u2026
      a diferencia de esas, \xA1yo soy completamente incansable!"
    voiceClip: {fileID: 0}
  opciones: []
