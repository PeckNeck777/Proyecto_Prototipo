  - spaeker: Maestro Logan Niza
    portrait: {fileID: 21300000, guid: 31c7bdf4c59771145b41354d826d2009, type: 3}
    line: "Entonces j\xF3venes \xBFAlguna duda? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Pensando en voz alta y riendo) Logan Niza\u2026 Longaniza\u2026 carajo\u2026
      \xBFPor qu\xE9 le pusieron ese nombre?"
    voiceClip: {fileID: 0}
  - spaeker: Maestro Logan Niza
    portrait: {fileID: 21300000, guid: 31c7bdf4c59771145b41354d826d2009, type: 3}
    line: "\xA1MIZUKI! \xBF\xA1Se puede saber que est\xE1 balbuceando?! "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Ah\u2026 D-de\u2026 \xBFLazz se est\xE1 repitiendo\u2026 todo otra vez? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(\xA1AHH! CONTROLATE Y NO DIGAS NADA!)"
    voiceClip: {fileID: 0}
