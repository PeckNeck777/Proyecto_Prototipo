MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 99b96955713899042b7125f4d9066314, type: 3}
  m_Name: Jendar_Dialogo_Viernes
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Joder\u2026 por primera vez no hueles a felpa de mierda\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "\xA1JA! Ya era hora de dejar respirar a mi pobre cuerpo. Pero\u2026 \xBFsabes?
      Estos cinco a\xF1os bajo esa m\xE1scara me hicieron pensar bastante."
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFSobre qu\xE9?"
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "Sobre m\xED, supongo\u2026 Durante mucho tiempo intent\xE9 encajar en
      lo que los dem\xE1s esperaban. Que si deb\xEDa ser un chico\u2026 una chica\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "\xA1Pura mierda!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFY ahora?"
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "Creo que estoy en alg\xFAn punto del espectro donde\u2026 no soy ninguno
      de los dos. \xBFDesde cu\xE1ndo tener tetas o un pito decide qui\xE9n soy?"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Ah\u2026 \xBFY c\xF3mo te sientes?"
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "\xA1M\xE1s libre que nunca! No tengo que escoger entre ser una cosa u
      otra para saber qui\xE9n soy. \xA1Puedo simplemente ser Jendar!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Se siente bien\u2026 \xBFno?"
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "\xA1Much\xEDsimo! Aunque\u2026 me pregunto si el maestro usar\xE1 \xABelle\xBB
      conmigo."
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Si lo hace\u2026 solo dar\xE1 una charla de viejo de \xE9poca."
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "\xA1JA! \xA1Estar\xE9 expectante por verlo!"
    voiceClip: {fileID: 0}
  opciones: []
