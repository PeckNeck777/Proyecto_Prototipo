  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Molle S. Ight
    portrait: {fileID: 21300000, guid: 3fd2f0cd1a99de6438154747a456671d, type: 3}
    line: "\xA1Finalmente viernes! "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Si\u2026 un d\xEDa m\xE1s para luego estar lejos de este lugar llamado
      sal\xF3n de clases\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Molle S. Ight
    portrait: {fileID: 21300000, guid: 3fd2f0cd1a99de6438154747a456671d, type: 3}
    line: 'Lo dices como si fuera una pesadilla '
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Lo es\u2026 en cierto modo\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Molle S. Ight
    portrait: {fileID: 21300000, guid: 3fd2f0cd1a99de6438154747a456671d, type: 3}
    line: "(Sarc\xE1stico) Auch, \xA1gracias! "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Mol\u2026 sabes que no lo dec\xEDa as\xED\u2026 t\xFA eres la raz\xF3n
      por la que sigo viniendo a este sal\xF3n en lugar de tomar clases virtuales   "
    voiceClip: {fileID: 0}
  - spaeker: Molle S. Ight
    portrait: {fileID: 21300000, guid: 3fd2f0cd1a99de6438154747a456671d, type: 3}
    line: "Lo se\u2026 solo te molesto "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: Lo que tienes de humor te falta en vista
    voiceClip: {fileID: 0}
  opciones: []
