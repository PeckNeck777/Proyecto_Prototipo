  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Ah... al igual que en el trabajo, aqu\xED tambi\xE9n hay un pito dibujado."
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "La gente tiende a dibujarlos mucho, \xBFno? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Aunque claro, bien dice el dicho: \"Quien hambre tiene, con pan sue\xF1a
      \". "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "De ser as\xED, el imb\xE9cil que los dibuja todo el tiempo debe andar
      con antojo todo el d\xEDa. "
    voiceClip: {fileID: 0}
  opciones: []
