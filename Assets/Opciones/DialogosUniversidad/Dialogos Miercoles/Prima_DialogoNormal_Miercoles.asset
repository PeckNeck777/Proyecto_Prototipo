  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 99b96955713899042b7125f4d9066314, type: 3}
  m_Name: Prima_DialogoNormal_Miercoles
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "\xA1Qu\xE9 d\xEDa tan perfecto! Si algo brilla m\xE1s que el sol\u2026
      \xA1De seguro ser\xEDa yo y nadie m\xE1s!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFNo estar\xEDas ardiendo a m\xE1s de 5,500 grados?"
    voiceClip: {fileID: 0}
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "Cielo, yo ya soy ardiente\u2026 un peque\xF1o ajuste en la temperatura\u2026
      no cambiar\xEDa nada."
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Mierda\u2026 quisiera tener esa confianza\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "Consigue un sentido de la moda\u2026 y luego me hablas \xBFS\xED?"
    voiceClip: {fileID: 0}
  - spaeker: Prima Donna
    portrait: {fileID: 21300000, guid: 18886ddef4b8511469a8c5fb590c74ae, type: 3}
    line: "Oh, por cierto, deja de merodear tanto cerca de Alicia. No querr\xE1s
      contagiarle esa vibra de \"lunes por la ma\xF1ana\" que cargas."
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Mierda\u2026 odio a esta insoportable)"
    voiceClip: {fileID: 0}
  opciones: []
