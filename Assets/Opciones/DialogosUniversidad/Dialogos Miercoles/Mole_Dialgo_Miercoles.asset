  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Molle S. Ight
    portrait: {fileID: 21300000, guid: 3fd2f0cd1a99de6438154747a456671d, type: 3}
    line: "\xBFY c\xF3mo van las cosas con Alicia? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Ah\u2026 y-ya sabes\u2026 pues ah\xED\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Molle S. Ight
    portrait: {fileID: 21300000, guid: 3fd2f0cd1a99de6438154747a456671d, type: 3}
    line: "Sabes\u2026 ella se est\xE1 perdiendo una oportunidad\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFD-de verdad lo crees? "
    voiceClip: {fileID: 0}
  - spaeker: Molle S. Ight
    portrait: {fileID: 21300000, guid: 3fd2f0cd1a99de6438154747a456671d, type: 3}
    line: "\xA1S\xED! Imagina tener la gran oportunidad de olvidarte\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\u2026 Te putas odio\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Molle S. Ight
    portrait: {fileID: 21300000, guid: 3fd2f0cd1a99de6438154747a456671d, type: 3}
    line: "Ambas sabemos que eso no es verdad\u2026 \xA1Me adoras! "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Lo peor es que es cierto\u2026 tu estando tan ciega eres la mejor"
    voiceClip: {fileID: 0}
  opciones: []
