  m_Script: {fileID: 11500000, guid: 99b96955713899042b7125f4d9066314, type: 3}
  m_Name: Jendar_Dialogo_Jueves
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "\xBFPor qu\xE9 la ropa es tan\u2026 cara?  "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFDe qu\xE9 hablas? "
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "Mis perros se est\xE1n comiendo mi ropa\u2026 tuve que venir con este
      mo\xF1o el d\xEDa de hoy\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFY como explicas la faldita? "
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "Pues ten\xEDa que combinar \xBFno? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Si\u2026 pero no lo s\xE9\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Jendar Less
    portrait: {fileID: 21300000, guid: 50f22e9babf93c846be501466ed38614, type: 3}
    line: "Bueno\u2026 t\xFA vistes lo mismo cada d\xEDa\u2026 ojal\xE1 tener la
      valent\xEDa de poder hacer eso "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "No se\u2026 si eso sea un cumplido o no\u2026 "
    voiceClip: {fileID: 0}
  opciones: []
