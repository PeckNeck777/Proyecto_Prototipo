  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "Soy el conserje\u2026 conocido como... "
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "\xA1El \xE9xito!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Ah\u2026 \xBFY por qu\xE9 siempre est\xE1 sucio todo?"
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "\xA1Por que el \xE9xito lleva tiempo! "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Y sorpresivamente\u2026 tiene raz\xF3n)"
