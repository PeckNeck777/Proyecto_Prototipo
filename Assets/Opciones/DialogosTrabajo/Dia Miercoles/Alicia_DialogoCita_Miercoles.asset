  m_Script: {fileID: 11500000, guid: 99b96955713899042b7125f4d9066314, type: 3}
  m_Name: Alicia_DialogoCita_Miercoles
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Mizuki! Qu\xE9 bien que te veo\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "Vaya\u2026 \xA1te ves m\xE1s linda hoy! Y no, no lo digo por decir, \xA1es
      que hoy te pusiste la blusa que te queda bien!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Eso\u2026 \xBFTe fijaste en lo que llevo puesto?"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Claro! Tengo que estar preparada para lo del s\xE1bado."
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "Por cierto, ya puse tres alarmas en el tel\xE9fono y un post-it en el
      espejo para que no se me olvide ning\xFAn detalle. \xA1Ya casi es el gran d\xEDa!"
    voiceClip: {fileID: 0}
  opciones:
  - {fileID: 11400000, guid: 0feb9e160d9c69f45ae089f8c76d3033, type: 2}
  - {fileID: 11400000, guid: f77a25ee97d80874e92f483ed321d9f3, type: 2}
