  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Mizuki! Qu\xE9 bien que te veo\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "Vaya\u2026 \xA1te ves m\xE1s cansada hoy! \xBFO fue ayer? Bueno, da igual."
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFAh? \xBFTan mala cara tengo?"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "No mal, solo\u2026 como si un cami\xF3n te hubiera pasado por encima.
      Deber\xEDas dormir m\xE1s en lugar de trasnochar tanto con tus proyectos de
      la U."
    voiceClip: {fileID: 0}
