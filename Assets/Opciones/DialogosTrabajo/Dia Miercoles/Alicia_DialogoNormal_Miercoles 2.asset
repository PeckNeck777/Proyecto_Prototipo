  conversation:
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "Ay, la U siempre arruin\xE1ndonos la vida."
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "Si necesitas desahogarte, ya sabes d\xF3nde encontrarme\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "Aunque probablemente se me olvide la mitad de lo que me digas, \xA1as\xED
      que tenme paciencia!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Mierda\u2026 quisiera que al menos recordara las cosas importantes, pero
      es imposible)"
    voiceClip: {fileID: 0}
