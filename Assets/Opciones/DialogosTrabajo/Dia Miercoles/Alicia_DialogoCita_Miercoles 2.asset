  conversation:
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Oye! \xA1Estoy haciendo mi mejor esfuerzo!"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "Antes ni me acordaba de en qu\xE9 d\xEDa viv\xEDa, pero contando los d\xEDas
