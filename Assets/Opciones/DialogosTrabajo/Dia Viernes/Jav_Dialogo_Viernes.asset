  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Jav A.B. Ean
    portrait: {fileID: 21300000, guid: 09e6cc846509ec146bae7b516b5c5301, type: 3}
    line: "Carajo\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Jav A.B. Ean
    portrait: {fileID: 21300000, guid: 09e6cc846509ec146bae7b516b5c5301, type: 3}
    line: "Es viernes y el fin de semana estar\xE9 en actividades para padres\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Jav A.B. Ean
    portrait: {fileID: 21300000, guid: 09e6cc846509ec146bae7b516b5c5301, type: 3}
    line: "\xBFA qui\xE9n se le ocurri\xF3 hacerlas los fines de semana? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Quiz\xE1s esa persona pens\xF3 que los padres no podr\xEDan estar muy
      presentes entre semana\u2026 y que quiz\xE1s iban a estar jodidos emocionalmente "
    voiceClip: {fileID: 0}
  - spaeker: Jav A.B. Ean
    portrait: {fileID: 21300000, guid: 09e6cc846509ec146bae7b516b5c5301, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Jav A.B. Ean
    portrait: {fileID: 21300000, guid: 09e6cc846509ec146bae7b516b5c5301, type: 3}
    line: "Vete a la mierda\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: Ya me encuentro ahi, pendejo
    voiceClip: {fileID: 0}
  opciones: []
