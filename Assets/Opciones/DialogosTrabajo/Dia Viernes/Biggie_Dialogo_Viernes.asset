    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Mierda\u2026 mierda\u2026 ya termino esta semana\u2026 finalmente a descansar\u2026) "
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "Tranquila muchacha, yo tambi\xE9n sobre pensaba todo..."
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "\xA1Y m\xEDrame!"
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "\xA1Soy el \xE9xito!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xA1\xBFC\xF3mo carajos sabes que estoy pensando!? "
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "\xA1El \xE9xito no revela sus secretos!"
    voiceClip: {fileID: 0}
