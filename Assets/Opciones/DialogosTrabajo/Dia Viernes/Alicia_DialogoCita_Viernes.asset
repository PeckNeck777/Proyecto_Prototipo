  m_Script: {fileID: 11500000, guid: 99b96955713899042b7125f4d9066314, type: 3}
  m_Name: Alicia_DialogoCita_Viernes
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Mizu! Ya es viernes\u2026 lo que significa\u2026 \xA1Ma\xF1ana ser\xE1
      la cita! \xBFNo est\xE1s emocionada?"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "S\xED\u2026 lo estoy."
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Bien! Porque llevo toda la semana pensando en ma\xF1ana\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFDe verdad?"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Claro! Quiero que sea un d\xEDa especial para las dos\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Y que podamos disfrutarlo juntas!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Mierda\u2026 mi coraz\xF3n\u2026)"
    voiceClip: {fileID: 0}
  opciones: []
