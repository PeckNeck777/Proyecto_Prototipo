  conversation:
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Claro que me acuerdo! \xBFC\xF3mo crees que iba a olvidar algo as\xED?
      De hecho\u2026 estaba pensando qu\xE9 ponerme, no quiero verme desarreglada."
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "An\xF3tame la direcci\xF3n aqu\xED en mi libreta por si acaso se me borra
      de la mente al rato, \xBFs\xED?\u201D"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Se acuerda de la cita, pero necesita que le anote la direcci\xF3n\u2026
      es tan ella, y aun as\xED, me hace feliz.)"
    voiceClip: {fileID: 0}
  opciones: []
