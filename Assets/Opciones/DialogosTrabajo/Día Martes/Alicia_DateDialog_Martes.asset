  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Mizuki! Justo a ti te quer\xEDa ver\u2026 \xA1No encuentro mi taza
      favorita y ando dando vueltas como loca!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Alicia\u2026 la tienes agarrada en la mano derecha."
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Ay, no puede ser! Qu\xE9 cabeza la m\xEDa\u2026 En fin, \xBFc\xF3mo
      va tu ma\xF1ana?"
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "Vaya, te ves\u2026 distinta hoy. \xBFTe cambiaste el peinado o estrenas
      su\xE9ter? Te queda muy bien, por cierto."
    voiceClip: {fileID: 0}
