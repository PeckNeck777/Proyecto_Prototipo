  conversation:
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xA1Oye! Olvidar\xE9 d\xF3nde dejo las llaves o qu\xE9 d\xEDa es, pero
      los detalles importantes\u2026 esos se me quedan grabados. Y ver que est\xE1s
      emocionada por lo de este fin de semana me alegra el d\xEDa."
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xBFMe recuerdas a qu\xE9 hora nos ve\xEDamos?"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Olvid\xF3 la hora, pero no que le importa. Supongo que es lo \xFAnico
      que necesito.)"
    voiceClip: {fileID: 0}
  opciones: []
