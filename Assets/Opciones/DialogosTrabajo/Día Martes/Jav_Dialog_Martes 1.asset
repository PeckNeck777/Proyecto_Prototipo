  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Te noto cansado\u2026 m\xE1s de lo usual \xBFQue carajos paso? "
    voiceClip: {fileID: 0}
  - spaeker: Jav A.B. Ean
    portrait: {fileID: 21300000, guid: 09e6cc846509ec146bae7b516b5c5301, type: 3}
    line: "Trata de sobrevivir a ayudar a 3 ni\xF1os a hacer tarea luego de una jornada
      laboral y luego me cuentas "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: 'No gracias, ya tengo suficiente con mi vida de mierda '
    voiceClip: {fileID: 0}
  - spaeker: Jav A.B. Ean
    portrait: {fileID: 21300000, guid: 09e6cc846509ec146bae7b516b5c5301, type: 3}
    line: "Tambi\xE9n yo\u2026 \xA1pero esos 3 ni\xF1os me ayudan a no ir a una mejor
      vida! "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "(Ojala tener algo asi\u2026)"
    voiceClip: {fileID: 0}
  opciones: []
