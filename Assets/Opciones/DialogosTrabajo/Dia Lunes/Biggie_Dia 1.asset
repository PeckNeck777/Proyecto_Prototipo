  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Y una mierda\u2026 deber\xEDa de renunciar y decirle a Alicia lo que siento\u2026
      pero quiz\xE1s no hacer nada sea mejor\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "Tranquila ni\xF1a "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFNi\xF1a? "
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "Yo tambi\xE9n no pude renunciar a un trabajo que me hac\xEDa miserable
      y deje que el amor de mi vida se fuera con otro tipo"
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "\xA1Y m\xEDrame!"
    voiceClip: {fileID: 0}
  - spaeker: Biggie Shott
    portrait: {fileID: 21300000, guid: 7194fc771ae47a04c886a5720f202fd4, type: 3}
    line: "\xA1Soy el \xE9xito! "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Si por \xE9xito te refieres a estar jodido\u2026"
    voiceClip: {fileID: 0}
  opciones: []
