  m_Name: Bambu
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "El bamb\xFA... \xA1Una planta que comen los tiernos pandas! O una planta
      decorativa de Minecraft."
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Me encanta la est\xE9tica japonesa, pero... \xBFsab\xEDas que usaban esta
      planta como m\xE9todo de tortura?"
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Consist\xEDa en atar a alguien sobre un brote de bamb\xFA afilado... \xA1Esta
      mierda puede crecer hasta 4 cent\xEDmetros por hora!"
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Bueno... no hace falta explicar qu\xE9 le pasaba al torturado con el tiempo..."
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Podr\xEDamos decir que su comida favorita en definitiva NO eran las brochetas. "
