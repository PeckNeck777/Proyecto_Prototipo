  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Llevas a\xF1os soportando todo\u2026  "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Creo que estar\xE1s bien con un dia que no bebas"
    voiceClip: {fileID: 0}
  - spaeker: Jav A.B. Ean
    portrait: {fileID: 21300000, guid: 09e6cc846509ec146bae7b516b5c5301, type: 3}
    line: "Nah\u2026 no lo entender\xEDas\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "De seguro no\u2026 aunque en eso de estar jodida..."
