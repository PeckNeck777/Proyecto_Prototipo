  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "No te preocupes\u2026 solo fui a ver a mis padres\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "Hija\u2026 \xBFEsa es la chica que te gusta\u2026? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xA1Mam\xE1, NO DIGAS ESO! "
    voiceClip: {fileID: 0}
  - spaeker: Alicia Heimer
    portrait: {fileID: 21300000, guid: b2ced09482f683442aa936118b4fdf59, type: 3}
    line: "\xBF... Gustar\u2026? "
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "No la escuches\u2026 solo est\xE1 medio dormida\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFVERDAD? "
    voiceClip: {fileID: 0}
  - spaeker: Mr. Wor Kaholic
    portrait: {fileID: 21300000, guid: 0519b52476c18964a84f9614c3e74de4, type: 3}
    line: "No lo est\xE1\u2026 ella siempre habla de ti cuando viene "
