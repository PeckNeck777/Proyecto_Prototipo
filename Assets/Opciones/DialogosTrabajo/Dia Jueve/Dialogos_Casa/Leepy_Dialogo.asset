  m_Script: {fileID: 11500000, guid: 99b96955713899042b7125f4d9066314, type: 3}
  m_Name: Leepy_Dialogo
  m_EditorClassIdentifier: Assembly-CSharp::Dialog
  conversation:
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: ...
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "Zzzz\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "Ah\u2026 \xBFMizuki?"
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "\xBFA\u2026 a qu\xE9 hora llegaste, mi vida?"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "Acabo de venir, mam\xE1. \xBFC\xF3mo va todo?"
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "Ah\u2026 todo bien, cari\xF1o\u2026 Solo estoy algo cansada\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "Zzzz\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "\xBFIgual que siempre, entonces?"
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "(Sobresaltada) \xA1Ah! \xA1Perd\xF3n, hija!"
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "Es que \xFAltimamente no consigo mantener los ojos abiertos\u2026"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "No te preocupes, mam\xE1\u2026 Descansa un poco. Creo que explorar\xE9
      la casa."
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "Est\xE1 bien, mi vida\u2026 "
    voiceClip: {fileID: 0}
  - spaeker: Mrs. Leepy Head
    portrait: {fileID: 21300000, guid: 1a7bbad881ced9e4f9b4f45c7f7cf51e, type: 3}
    line: "\xA1Pero no te vayas sin despedirte!"
    voiceClip: {fileID: 0}
  - spaeker: Mizuki
    portrait: {fileID: 21300000, guid: 3e2ff052315324a40ad96395d365d6e4, type: 3}
    line: "No lo har\xE9."
    voiceClip: {fileID: 0}
  opciones: []
